 {
@@ -1980,6 +2048,13 @@ drag_context_grab (GdkDrag *drag)
   cursor = gdk_drag_get_cursor (drag, gdk_drag_get_selected_action (drag));
   gdk_win32_drag_set_cursor (drag, cursor);
 
+  if (drag_win32->background_pointer_source == 0)
+    drag_win32->background_pointer_source =
+      g_timeout_add_full (G_PRIORITY_DEFAULT, 16,
+                          drag_background_pointer_poll,
+                          g_object_ref (drag),
+                          g_object_unref);
+
   /* TODO: Should be grabbing keys here, to support keynav. SetWindowsHookEx()? */
 
   return TRUE;
@@ -1995,6 +2070,12 @@ drag_context_ungrab (GdkDrag *drag)
                           drag,
                           drag_win32->grab_seat));
 
+  if (drag_win32->background_pointer_source != 0)
+    {
+      g_source_remove (drag_win32->background_pointer_source);
+      drag_win32->background_pointer_source = 0;
+    }
+
   if (!drag_win32->grab_seat)
