# Templates and signed text fixtures must have identical bytes on every platform.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Signed payloads, malformed samples, and other fixtures are byte-exact test data.
tests/fixtures/** -text

# PDF xref entries are byte offsets; never convert their line endings.
*.pdf -text
tests/fixtures/documents/*.pdf whitespace=-blank-at-eol

# Rustfmt expects LF files on Windows runners even when core.autocrlf is enabled.
*.rs text eol=lf
